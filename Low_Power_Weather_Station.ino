#define BITMAP_WIDTH  128
#define BITMAP_HEIGHT 64


 void PrintOnDisplay(float T, float H, float P){

  display.clearDisplay();
  display.setCursor(0, 0);

  if (isnan(T) || isnan(H) || isnan(P)) {
    Serial.println(F("Blad odczytu z sensora"));
    display.println(F("Blad odczytu"));
    display.println(F("z sensora..."));
  }

  else {
    display.println(F("Temperatura:"));
    display.print(T, 2);
    display.println(F(" C\n"));

    display.println(F("Wilgotnosc:"));
    display.print(H, 1);
    display.println(F(" %\n"));

    display.println(F("Cisnienie:"));
    display.print(P, 1);
    display.println(F(" hPa"));

  }
  display.display();

}


void setup() {
  Serial.begin(115200);
  delay(250);
  Wire.begin(I2C_SDA, I2C_SCL);

  if(!display.begin(i2c_OLED, true)) {
    Serial.println(F("Nie znaleziono OLED"));
    for(;;);
  }

  display.clearDisplay();
  display.drawBitmap(0, 0, epd_bitmap_New_Piskel_1, BITMAP_WIDTH, BITMAP_HEIGHT, SH110X_WHITE);
  display.display();
  delay(3000); 
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);

  if (!bme.begin(0x76, &Wire)) {
    Serial.println(F("Nie znaleziono BME280"));
  }

  bme.setSampling(Adafruit_BME280::MODE_FORCED,
      Adafruit_BME280::SAMPLING_X1,
      Adafruit_BME280::SAMPLING_X1,
      Adafruit_BME280::SAMPLING_X1,
      Adafruit_BME280::FILTER_OFF);

  bme.takeForcedMeasurement();
  delay(50);
  float T = bme.readTemperature();
  float H = bme.readHumidity();
  float P = bme.readPressure() / 100.0F;

  PrintOnDisplay(T, H, P);    
  esp_sleep_enable_timer_wakeup(150000000);
  esp_deep_sleep_start();
}
void loop() { 

} 
